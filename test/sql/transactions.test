# name: test/sql/transactions.test
# description: Transactional attaches stage light changes and send them at COMMIT
# group: [hue]

require vgi

require-env HUE_WORKER

require-env HUE_MOCK_BRIDGE

# `bridge` shows what the bridge really holds; `tx` stages its changes.
statement ok
ATTACH 'hue' AS bridge (TYPE vgi, LOCATION '{HUE_WORKER}', bridge '{HUE_MOCK_BRIDGE}', app_key 'test-key');

statement ok
ATTACH 'hue' AS tx (TYPE vgi, LOCATION '{HUE_WORKER}', bridge '{HUE_MOCK_BRIDGE}', app_key 'test-key', transactional true);

# A known starting point.
statement ok
UPDATE bridge.main.lights SET is_on = true, brightness = 50 WHERE room = 'Kitchen';

statement ok
UPDATE bridge.main.lights SET is_on = false, brightness = 30 WHERE light_id = 'l-sofa';

# ------------------------------------------------------------------ COMMIT

statement ok
BEGIN;

statement ok
UPDATE tx.main.lights SET brightness = 20 WHERE room = 'Kitchen';

# Inside the transaction its own pending change is visible...
query TR
SELECT name, brightness FROM tx.main.lights WHERE room = 'Kitchen' ORDER BY name;
----
Kitchen ceiling	20.0
Kitchen pendant	20.0

# ...but nothing has reached the bridge yet.
query TR
SELECT name, brightness FROM bridge.main.lights WHERE room = 'Kitchen' ORDER BY name;
----
Kitchen ceiling	50.0
Kitchen pendant	50.0

statement ok
COMMIT;

query TR
SELECT name, brightness FROM bridge.main.lights WHERE room = 'Kitchen' ORDER BY name;
----
Kitchen ceiling	20.0
Kitchen pendant	20.0

# ---------------------------------------------------------------- ROLLBACK

statement ok
BEGIN;

statement ok
UPDATE tx.main.lights SET brightness = 99 WHERE room = 'Kitchen';

statement ok
ROLLBACK;

query R
SELECT max(brightness) FROM bridge.main.lights WHERE room = 'Kitchen';
----
20.0

# ------------------------------------------------- control functions stage too

statement ok
BEGIN;

query TT
SELECT name, ok FROM tx.main.set_light('Sofa lamp', power := true, brightness := 77);
----
Sofa lamp	true

# A staged room command has nothing to wait for yet: settled is NULL.
query TT
SELECT name, settled IS NULL FROM tx.main.set_room('Kitchen', brightness := 66, wait_ms := 2000);
----
Kitchen	true

query TR
SELECT is_on, brightness FROM bridge.main.lights WHERE light_id = 'l-sofa';
----
false	30.0

statement ok
COMMIT;

query TR
SELECT is_on, brightness FROM bridge.main.lights WHERE light_id = 'l-sofa';
----
true	77.0

query R
SELECT max(brightness) FROM bridge.main.lights WHERE room = 'Kitchen';
----
66.0

# Several changes to one light in a transaction: the last value wins.
statement ok
BEGIN;

statement ok
UPDATE tx.main.lights SET brightness = 10 WHERE light_id = 'l-sofa';

statement ok
UPDATE tx.main.lights SET brightness = 15, color_hex = '#0000ff' WHERE light_id = 'l-sofa';

statement ok
COMMIT;

query RT
SELECT brightness, color_mode FROM bridge.main.lights WHERE light_id = 'l-sofa';
----
15.0	xy

# ------------------------------------------------ gradients and effects stage too

statement ok
BEGIN;

statement ok
UPDATE tx.main.lights SET gradient_hex = ['#ff8000', '#0000ff'] WHERE light_id = 'l-strip';

# The mode alone, after the staged points: re-sends the staged points.
statement ok
UPDATE tx.main.lights SET gradient_mode = 'segmented_palette', effect = 'prism' WHERE light_id = 'l-strip';

query TTT
SELECT gradient_hex, gradient_mode, effect FROM tx.main.lights WHERE light_id = 'l-strip';
----
[#ff8000, #0000ff]	segmented_palette	prism

query TTT
SELECT gradient_hex, gradient_mode, effect FROM bridge.main.lights WHERE light_id = 'l-strip';
----
[#ff0000, #00ff00, #0000ff]	interpolated_palette	no_effect

statement ok
COMMIT;

query TTT
SELECT gradient_hex, gradient_mode, effect FROM bridge.main.lights WHERE light_id = 'l-strip';
----
[#ff8000, #0000ff]	segmented_palette	prism

statement ok
BEGIN;

query TT
SELECT name, ok FROM tx.main.set_gradient('Hallway strip', ['#00ff00', '#ff0000', '#0000ff']);
----
Hallway strip	true

statement ok
UPDATE tx.main.lights SET color_x = 0.2, color_y = 0.6 WHERE light_id = 'l-sofa';

query TRR
SELECT gradient_hex, (SELECT color_x FROM tx.main.lights WHERE light_id = 'l-sofa'), (SELECT color_y FROM tx.main.lights WHERE light_id = 'l-sofa')
FROM tx.main.lights WHERE light_id = 'l-strip';
----
[#00ff00, #ff0000, #0000ff]	0.2	0.6

statement ok
ROLLBACK;

query TTR
SELECT gradient_hex, gradient_mode, (SELECT color_y FROM bridge.main.lights WHERE light_id = 'l-sofa')
FROM bridge.main.lights WHERE light_id = 'l-strip';
----
[#ff8000, #0000ff]	segmented_palette	0.0399

# A refused gradient at UPDATE time stages nothing.
statement ok
BEGIN;

statement error
UPDATE tx.main.lights SET gradient_mode = 'swirl' WHERE light_id = 'l-strip';
----
invalid gradient_mode 'swirl'

statement ok
ROLLBACK;

# A staged single colour clears the gradient as the transaction sees it, so
# gradient_mode alone is refused there, before anything is staged or sent.
statement ok
BEGIN;

statement ok
UPDATE tx.main.lights SET color_hex = '#0000ff' WHERE light_id = 'l-strip';

statement error
UPDATE tx.main.lights SET gradient_mode = 'random_pixelated' WHERE light_id = 'l-strip';
----
light 'Hallway strip' has no gradient to change the mode of; set gradient_hex or gradient_xy too

statement ok
ROLLBACK;

query T
SELECT gradient_hex FROM bridge.main.lights WHERE light_id = 'l-strip';
----
[#ff8000, #0000ff]

# ------------------------------------------- a refused commit puts lights back

# The white-only pendant cannot take a colour: the bridge refuses it at
# COMMIT, after the ceiling light has changed, so the ceiling is restored.
statement ok
BEGIN;

statement ok
UPDATE tx.main.lights SET brightness = 11 WHERE light_id = 'l-ceiling';

statement ok
UPDATE tx.main.lights SET color_hex = '#0000ff' WHERE light_id = 'l-pendant';

statement error
COMMIT;
----
COMMIT failed after 1 of 2 light changes

query R
SELECT brightness FROM bridge.main.lights WHERE light_id = 'l-ceiling';
----
66.0

# ------------------------------------------------- statements outside BEGIN

# DuckDB wraps every statement in a transaction: it applies as it commits.
statement ok
UPDATE tx.main.lights SET brightness = 33 WHERE light_id = 'l-sofa';

query R
SELECT brightness FROM bridge.main.lights WHERE light_id = 'l-sofa';
----
33.0

statement error
UPDATE tx.main.lights SET color_hex = '#00ff00' WHERE light_id = 'l-pendant';
----
COMMIT failed

# The ordinary attach still sends at once, with per-light errors from set_lights.
query TT
SELECT target_id, ok FROM bridge.main.set_lights((SELECT 'l-pendant' AS light_id), color := 'blue');
----
l-pendant	false
